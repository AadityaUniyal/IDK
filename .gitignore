# TRACE repository ignore rules

**/node_modules
**/.next
**/out
**/build
**/.env*
!.env.example
!**/.env.example

# Local databases and generated state
/data/
*.db
*.sqlite
*.sqlite3
*.tsbuildinfo
**/next-env.d.ts

# Logs, scratch files, and captured local sessions
*.log
*.tmp
*.bak
cookie*.txt
mid*.txt
*.trace
*.har
*.jsonl

# Test output
/coverage
/playwright-report
/test-results

# Tooling and operating-system files
.vercel
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.pem

# Package-manager and debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
